# Copy to .env and fill in. The .env file never goes to git.

# There is no password in the system: the only way in is a passkey. The first
# device is enrolled with a one-time code printed by the binary on the host:
#   docker compose exec aacpanel /aacpanel -enroll
# The code lives five minutes and works once.

# Cookie signing key: openssl rand -hex 32
# Changing it logs everyone out — that is how a session is revoked.
AACP_SECRET=

# Long-lived token for a local deployment: openssl rand -hex 24
#
# The second way in, needed where a passkey cannot work at all: the browser gives
# a key out only over https or on localhost. Where a passkey works, leave it
# empty. The token lets its holder in like a fingerprint does and has to be kept
# like a password; at least 24 characters, or the service refuses to start.
#AACP_TOKEN=

# --- database ---
# Password of aacpanel-db: openssl rand -hex 24
# Letters and digits only: it goes into the DSN as is.
AACP_DB_PASSWORD=

# Name of the database and of its owner role. Optional, aacpanel/aacpanel by
# default. The owner applies migrations.
#AACP_DB_NAME=aacpanel
#AACP_DB_USER=aacpanel

# Password of the application role the service works under in production: it has
# neither DDL nor TRUNCATE, so it cannot wipe the action journal. Created once by
# the owner:
#   AACP_APP_PASSWORD=$(openssl rand -hex 24) ./deploy/create-app-role.sh
# Empty means the service works as the owner.
AACP_APP_PASSWORD=

# Name of the application role. Set it together with the password above: compose
# builds the DSN from the two separately, and a password without a name connects
# as the owner with the wrong password.
#AACP_APP_ROLE=monitor_app

# --- panel addresses ---
# The panel is opened by domain, where the login lives. The page stays where it
# was opened, and API requests go to the nearest address that answered; CORS on
# every listener is open to exactly these.
#
# Domain: the first origin of AACP_RP_ORIGINS by default. Loopback:
# http://127.0.0.1:<port of AACP_LOCAL_ADDR> by default. The LAN address is only
# ever explicit, and only https with a real certificate: a page on https cannot
# reach an http address (mixed content), and a public CA issues nothing for a
# private address without a DNS name and DNS-01. TLS is served by the service
# itself, no nginx needed.
#AACP_PUBLIC_URL=https://panel.example
#AACP_LAN_URL=https://panel.example
#AACP_LAN_ADDR=:8443
# Where to publish the LAN port on the host: the home network interface and a
# port (443 gives an address without one). Loopback and 8443 by default.
#AACP_LAN_BIND=192.168.1.10
#AACP_LAN_PORT=443
# Certificate directory on the host (mounted read-only as /tls) and the file
# paths inside the container. File names come from the ACME client.
#AACP_TLS_DIR=/etc/ssl/aacpanel
#AACP_TLS_CERT=/tls/panel.example.crt
#AACP_TLS_KEY=/tls/panel.example.key

# --- tailscale ---
# A tailnet node as a container in the stack. Without a domain it is the way into
# the panel (serve-main.json); with one it is the fourth and farthest leg of the
# router (serve-leg.json → its own listener AACP_TS_ADDR). First login is the link
# in `docker compose logs tailscale` or a TS_AUTHKEY; the tailnet needs MagicDNS
# and HTTPS. Do not turn Funnel on.
#AACP_TAILSCALE=1
#AACP_TS_HOSTNAME=aacpanel
#AACP_TS_SERVE=./deploy/tailscale/serve-leg.json
#AACP_TS_ADDR=:8778
#AACP_TS_URL=https://aacpanel.tailnet-name.ts.net
#TS_AUTHKEY=

# --- how the panel is exposed ---
# The address port 8776 is published on. Localhost by default: that is where a
# tunnel client goes, and it is the one address every machine has. Another address
# is needed when the panel is reached from a different machine, for example the
# docker bridge (172.17.0.1) behind a reverse proxy. Two publications of the same
# port are refused by docker, so only one.
#
# Do not use 0.0.0.0: the panel can type into the terminal of a live claude
# session, that is, answer its own permission prompt.
#AACP_BIND=127.0.0.1

# Secure flag of the session cookie: 1 — https only (localhost counts as trusted),
# 0 — allow http. Zero is needed where the panel is opened by a local address
# without a certificate: otherwise the browser drops the cookie silently and the
# login screen comes back empty. Behind a reverse proxy and through tailscale
# serve keep 1. With the flag off over https the panel shows a "cookie without
# Secure" chip until it is back.
#AACP_SECURE=1

# --- passkey (WebAuthn) ---
# The domain keys are bound to. The RP ID is baked into the key itself: changing
# it invalidates every passkey at once. Localhost by default, because WebAuthn
# requires HTTPS everywhere else.
AACP_RP_ID=localhost
# Origins, comma-separated, with the scheme. They have to match where the panel is
# opened from, or the browser silently withholds the key.
AACP_RP_ORIGINS=http://localhost:8776
# The name the phone shows in its dialog.
#AACP_RP_NAME=aacpanel

# --- host ---
# Who owns the executor socket: the service runs under this uid/gid and the socket
# is 0600. 1000 by default; the installer writes the `id -u` / `id -g` of whoever
# installs. A wrong uid reads as "the executor does not answer" with a live one.
#AACP_UID=1000
#AACP_GID=1000

# Directory of the executor socket on the host: $XDG_RUNTIME_DIR/aacpanel-exec.
# /run/user/<uid>/aacpanel-exec by default; the installer writes the real one.
#AACP_EXEC_DIR=/run/user/1000/aacpanel-exec

# State directory of the host agent, mounted into the service read-only. It is
# needed here because compose does not read the host description: a moved
# directory is changed in both places, or the service gets the old one and the
# panel goes blind on every screen.
#AACP_STATE_DIR=/var/lib/aacpanel

# --- session ---
# Both deadlines are mandatory and cannot be turned off, zero included. The
# absolute one cannot be shorter than the idle one.
#AACP_SESSION_IDLE=30m
#AACP_SESSION_MAX=12h

# --- push ---
# Who to write to when something is wrong with the panel push (RFC 8292).
# https://$AACP_RP_ID by default. VAPID keys are created on first start and live
# in the database.
#AACP_PUSH_CONTACT=mailto:you@example.net
