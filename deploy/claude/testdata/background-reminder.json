{
  "about": "The background reminder at the end of a turn: the executor's hook (internal/hook) runs these cases. A case plays its stops in order against one state directory; at is seconds after t0, tasks name entries of tasks, payload is laid over the payload of the stop. says is null for nothing said, has and lacks for words in the reminder or text for all of it. marks names the tasks the marks file keeps after the stop, null for no file; exact is the whole file; listing names the files of the state and marks directories. before is the marks file as the case finds it, aged are files of the marks directory that old, in seconds, by the clock the hook prunes by. silent are inputs the hook answers with nothing and exit 0: a raw text, a payload, or an array nested that deep.",
  "session": "5a0c7d1e-2b3f-4a5b-8c6d-7e8f9a0b1c2d",
  "t0": 1790000000,
  "tasks": {
    "shell": {"id": "b1", "type": "shell", "status": "running", "description": "npm run dev", "command": "npm run dev"},
    "monitor": {"id": "m1", "type": "monitor", "status": "running", "description": "tail the build log", "server": "watch", "tool": "tail"},
    "agent": {"id": "a1", "type": "subagent", "status": "running", "description": "review the diff", "agent_type": "general-purpose"},
    "flow": {"id": "w1", "type": "workflow", "status": "running", "description": "audit", "name": "audit"},
    "odd": {"id": "t1", "type": "teammate", "status": "running", "description": "keeps the docs"},
    "odder": {"id": "t2", "type": ["x"], "status": "running", "description": "?"},
    "loop": {"id": "b2", "type": "shell", "status": "running", "description": "wait for ready", "command": "until grep -q ready log; do sleep 20; done"},
    "bounded": {"id": "b3", "type": "shell", "status": "running", "description": "wait for ready", "command": "timeout 600 bash -c 'until grep -q ready log; do sleep 20; done'"},
    "long": {"id": "l1", "type": "shell", "status": "running", "description": "two  words\nand xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}
  },
