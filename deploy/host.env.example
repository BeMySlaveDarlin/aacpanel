# Description of THIS machine, read by all three aacpanel processes: the service
# in the container, the host agent and the executor.
#
# Template, not a filled-in description: an empty value means "ask the machine",
# and the values below are the defaults of a typical install. Samples live in
# comments, never in values. Format is a systemd EnvironmentFile (KEY=value,
# # starts a comment); an explicitly set environment variable always wins.

# State directory: the agent snapshot, session questions, the conversation index,
# the model cache, the chat socket directory and this file. Compose does not read
# this file, so a moved directory is named in .env as well.
AACP_STATE_DIR=/var/lib/aacpanel

# How the panel names this host in its texts. Empty means the hostname, which is
# wrong inside the container: fill it in. For example: WORKSTATION.
AACP_HOST=

# Where the repository is cloned on this machine. The agent starts from here; a
# wrong path is `python3: can't open file` in journald every five seconds.
# For example: /opt/projects/aacpanel.
AACP_REPO=/opt/aacpanel

# The unix user the system units run as and who owns the graphical session. Read
# by people, not by the unit itself: User=/Group= do not expand variables, so the
# agent unit is a template and takes the user as its instance. Empty means the
# user of the process that reads it, which does not exist in the container: fill
# it in. For example: u.
AACP_UNIX_USER=

# The name of the main host session, the one living in the home directory. It has
# to match the name any restart script of your own uses, or the same directory
# ends up with two sessions under different names. Empty means the machine name in
# lowercase. For example: workstation.
AACP_HOME_SESSION=

# Locale a claude session starts with. The session starts through `env -i`, so
# nothing but this file gives it a locale, and without one non-ASCII text turns
# into question marks. Empty means C.UTF-8. Pick your own from `locale -a` only.
# For example: en_US.UTF-8.
AACP_LANG=

# Display of the graphical session the executor opens terminal windows in.
# :0 is the local screen, xrdp lives on its own number such as :10, and an empty
# value means no windows at all — sessions still start, they live in tmux.
DISPLAY=:0

# How to open a window to a session: a command template, since terminals take a
# command differently. The conversation itself lives in tmux and does not depend
# on the window.
#
#   konsole              — with its own flags
#   gnome-terminal --    — the command is appended as arguments
#   xfce4-terminal -e %s — the command goes as one string, %s marks its place
#   alacritty -e         — same as gnome-terminal
#
# An empty string means "do not open a window"; the session still starts.
#AACP_TERMINAL=konsole

# Whether to open a window together with the session. Kept apart from
# AACP_TERMINAL so that turning it off does not cost you the command template.
# Turned off by 0, no, off or false; anything else, empty included, keeps it on.
#AACP_TERMINAL_AUTO=1

# What the panel starts sessions with. Unset means plain `claude` from PATH. Name
# a path if you use a wrapper script: sessions start in a clean environment
# (`env -i`), so an alias from your .bashrc is not visible.
#AACP_CLAUDE=/home/u/bin/claude-wrapper

# The rest are optional: without them the place that reads them uses its own
# default. Uncomment and change what differs on a new machine.

# Roots inside which sessions may be opened, colon-separated as in PATH. Without
# it, the home directory of the owner.
#AACP_PROJECT_ROOTS=/srv/proj

# Roots the agent walks to collect the project list. Unset means the allowed roots
# minus the home directory, and the home directory itself when nothing is left —
# naming the real project root makes the list shorter.
#AACP_PROJECT_SCAN=/srv/proj

# Claude account directories (CLAUDE_CONFIG_DIR), colon-separated as in PATH; the
# first one counts as personal. A single account needs nothing here: everyone
# reads ~/.claude. A second one is created by its own config directory:
# `CLAUDE_CONFIG_DIR=<dir> claude`, log in there once, then name the directory.
#AACP_CLAUDE_HOME=/home/u/.claude:/home/u/.claude-work

# The accounts whose sign-in ./install.sh was told to leave for later,
# colon-separated. Only the installer reads it: a run that keeps the settings
# keeps that answer rather than open claude to sign in again.
#AACP_SIGN_IN_LATER=/home/u/.claude-work

# Registry of a contour wrapper, if this machine has one (the delivery has none).
# Read as the second source after the list above.
#AACP_CLAUDE_REGISTRY=/home/u/.claude-contours/registry.conf

# Codex home directories (CODEX_HOME), colon-separated as in PATH. Unset means
# ~/.codex. A home is named as a claude directory is: ~/.codex is personal,
# another directory gives its last name without the leading dot. It pairs with
# the claude account of that name — ~/.claude-work above is claude-work, a
# contour the registry names takes the registry's name — or else with the
# contour the installer put on the map under that name, work for the same
# account; so a directory named claude-work or work serves ~/.claude-work,
# and ~/.codex-work would be a contour codex-work of its own, paired with no
# account. Where both are listed the one named after the account wins; of two
# of one name, the first. A contour renamed on the map later pairs only by the
# account's name. New of a project whose agent is codex starts in the home its
# contour pairs with. The executor and the collector read this, each at its
# start. The installer asks for the homes where codex is on the machine, and
# puts the panel's hooks and tools into each one that is there.
#AACP_CODEX_HOMES=/home/u/.codex:/home/u/.codex-profiles/work

# What the panel starts codex with: its daemon, and codex in tmux. The installer
# asks for this program; unset, the executor tries the standalone installation,
# then PATH. The panel names the home in CODEX_HOME itself, so a
# wrapper that picks the home by the directory overrules it — name the codex
# program itself then.
#AACP_CODEX=/home/u/.codex/packages/standalone/current/bin/codex

# The cores the units the panel starts run on: every session with its window,
# the terminals of the panel, the codex daemons and the observers. Core numbers
# and ranges apart by commas, as systemd's CPUAffinity= takes them. Unset means
# wherever the system puts them. On a machine with fast and efficient cores,
# naming the efficient ones leaves the fast ones to you; an Intel kernel lists
# them in /sys/devices/cpu_atom/cpus. The executor reads this at its start. A
# value systemd would not take, or one naming a core the machine does not have,
# goes into its log with the reason, and the units run where the system puts
# them; a running session keeps the cores it started on.
#AACP_CORES=8-23

# Probes for local services on the "Machine" screen: name=host:port pairs,
# comma-separated. No default: only this machine knows what is worth probing.
#AACP_PROBE_PORTS=pg=127.0.0.1:5432,redis=127.0.0.1:6379

# Passkey domain and origins are container settings and live in .env next to
# AACP_SECRET, not here. Listed for completeness:
#AACP_RP_ID=panel.example.net
#AACP_RP_ORIGINS=https://panel.example.net
#AACP_RP_NAME=aacpanel
#AACP_PUSH_CONTACT=mailto:you@example.net

# How many processes the agent parses transcripts in when the panel asks for usage.
# Four by default rather than "as many cores as there are": the agent lives on a
# working machine.
#AACP_USAGE_WORKERS=4
